<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.MachineLearning.Algorithms</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Classic ML.NET trainers plus typed Features&lt;T&gt; Naive Bayes (Gaussian/Bernoulli), FastTree, LightGBM, SDCA, time series, and recommenders.</Description>
    <RootNamespace>Novolis.MachineLearning.Algorithms</RootNamespace>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML" />
    <PackageReference Include="Microsoft.ML.DataView" />
    <PackageReference Include="Microsoft.ML.FastTree" />
    <PackageReference Include="Microsoft.ML.ImageAnalytics" />
    <PackageReference Include="Microsoft.ML.LightGbm" />
    <PackageReference Include="Microsoft.ML.OnnxTransformer" />
    <PackageReference Include="Microsoft.ML.Recommender" />
    <PackageReference Include="Microsoft.ML.TimeSeries" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
  </ItemGroup>
</Project>
